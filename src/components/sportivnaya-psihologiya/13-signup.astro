---
// sportivnaya-psihologiya: блок 13. Перенесён со старой страницы (scripts/legacy-to-astro.mjs). Цена и формы — общие компоненты, настройки в src/data/pages/sportivnaya-psihologiya.json.
import LeadForm from '../LeadForm.astro';
import page from '../../data/pages/sportivnaya-psihologiya.json';
---
      <!-- ============ 13. Форма заявки ============
           Общий компонент Академии (web-academy/shared/academy/request-form.md), режим «курс».
           Заголовок формы page.js берёт из CMS: «Занятия начнутся …», только если у потока есть дата.
           Заявка уходит через нативную форму Тильды «sport-psy», которая уже стоит на живой странице (rec2163116591). -->
      <section class="sport-signup_component section-spacing_component" id="signup">
        <div class="padding-global">
          <div class="container-xlarge">
      <LeadForm id={page.forms.signup.id} form={page.forms.signup.form} options={page.forms.signup.options} lead={page.forms.signup.lead} cmsHeading={page.forms.signup.cmsHeading} />
          </div>
        </div>
      </section>
