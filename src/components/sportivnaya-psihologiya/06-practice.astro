---
// sportivnaya-psihologiya: блок 6. Перенесён со старой страницы (scripts/legacy-to-astro.mjs).
---
      <!-- ========== 6. Как устроено обучение ==========
           Тёмная плашка #2B2334, внутри бенто из шести карточек с маленькими SVG-анимациями (референс Дарьи 25.11.2026:
           block-feature с 21st.dev). Порядок карточек повторяет путь студента: лекция → практикум и отработка →
           обратная связь → итоговый проект, потом форматы занятий и условие диплома.
           Анимации облегчены под Safari: без фильтров, размытия и foreignObject; двигаются только transform, opacity
           и пунктир линий. За экраном и при «уменьшить движение» всё стоит (page.js, раздел «Практика»).
           Можно править: тексты заголовков карточек (h3) и подписи форматов в ленте (их же повторяет список для скринридера).
           🟢 Пояснения к шагам 1, 4 и 5 написаны при вёрстке, сверить с Дарьей. -->
      <section class="sport-practice_component section-spacing_component" id="practice" aria-labelledby="practice-heading">
        <div class="padding-global">
          <div class="container-xlarge">
            <div class="sport-practice_plate" data-practice>
              <div class="section-header_component is-left is-responsive">
                <h2 class="section-title_component is-left is-responsive" id="practice-heading">Практика занимает 70&nbsp;% обучения</h2>
                <p class="section-subtitle_component">Каждую тему сначала смотрите в&nbsp;лекции, потом отрабатываете вживую и&nbsp;получаете обратную связь</p>
              </div>
              <ol class="sport-practice_bento">

                <!-- 1. Лекции: сетка недель, одна клетка с лекцией «пульсирует» -->
                <li class="sport-practice_card is-lecture">
                  <h3 class="content-heading_component is-compact">Новые лекции в&nbsp;записи каждую неделю</h3>
                  <div class="sport-practice_visual" aria-hidden="true">
                    <svg class="sport-practice_svg" viewBox="0 0 300 180" fill="none">
                      <defs>
                        <radialGradient id="practice-fade"><stop offset=".55" stop-color="#fff"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
                        <mask id="practice-grid-mask"><rect width="300" height="180" fill="url(#practice-fade)"/></mask>
                      </defs>
                      <g mask="url(#practice-grid-mask)" stroke="currentColor" stroke-opacity=".24">
                        <path d="M10 6v168M66 6v168M122 6v168M178 6v168M234 6v168M290 6v168M10 6h280M10 62h280M10 118h280M10 174h280"/>
                      </g>
                      <rect x="122" y="62" width="56" height="56" fill="#7c5cdb" fill-opacity=".28"/>
                      <rect class="sport-practice_pulse" x="122" y="62" width="56" height="56" stroke="#a48df0" stroke-width="1.5"/>
                      <path d="M143 79.5v21l17-10.5z" fill="#fff"/>
                    </svg>
                  </div>
                </li>

                <!-- 2. Практикум в Zoom: камера сверху, от неё сигнал бежит к трём формам отработки -->
                <li class="sport-practice_card is-workshop">
                  <div class="sport-practice_visual" aria-hidden="true">
                    <svg class="sport-practice_svg" viewBox="0 0 420 220" fill="none">
                      <rect x="150" y="10" width="120" height="64" rx="18" fill="#fff" fill-opacity=".06" stroke="currentColor" stroke-opacity=".22"/>
                      <path d="M186 31h30a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6h-30a6 6 0 0 1-6-6V37a6 6 0 0 1 6-6Zm36 13 18-10v26l-18-10" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>
                      <g stroke="currentColor" stroke-opacity=".22" stroke-width="1.5">
                        <path id="practice-wire-1" d="M190 74v16a20 20 0 0 1-20 20h-50a20 20 0 0 0-20 20v18"/>
                        <path id="practice-wire-2" d="M210 74v74"/>
                        <path id="practice-wire-3" d="M230 74v16a20 20 0 0 0 20 20h50a20 20 0 0 1 20 20v18"/>
                      </g>
                      <g class="sport-practice_signal" stroke="#a48df0" stroke-width="2" stroke-linecap="round">
                        <path pathLength="100" d="M190 74v16a20 20 0 0 1-20 20h-50a20 20 0 0 0-20 20v18"/>
                        <path pathLength="100" d="M210 74v74"/>
                        <path pathLength="100" d="M230 74v16a20 20 0 0 0 20 20h50a20 20 0 0 1 20 20v18"/>
                      </g>
                      <g fill="#3b2e49" stroke="currentColor" stroke-opacity=".22">
                        <circle cx="100" cy="182" r="34"/><circle cx="210" cy="182" r="34"/><circle cx="320" cy="182" r="34"/>
                      </g>
                      <g stroke="#fff" stroke-width="2.5" stroke-linecap="round">
                        <!-- Пара и тройка: фигурки стоят рядом с зазором, линии не пересекаются -->
                        <circle cx="88" cy="175" r="5"/><path d="M78.5 196a9.5 9.5 0 0 1 19 0"/>
                        <circle cx="112" cy="175" r="5"/><path d="M102.5 196a9.5 9.5 0 0 1 19 0"/>
                        <circle cx="193" cy="177" r="4"/><path d="M186 195a7 7 0 0 1 14 0"/>
                        <circle cx="210" cy="177" r="4"/><path d="M203 195a7 7 0 0 1 14 0"/>
                        <circle cx="227" cy="177" r="4"/><path d="M220 195a7 7 0 0 1 14 0"/>
                        <path d="M305 170h30a4 4 0 0 1 4 4v15a4 4 0 0 1-4 4h-18l-9 7v-7h-3a4 4 0 0 1-4-4v-15a4 4 0 0 1 4-4Z" stroke-linejoin="round"/>
                      </g>
                    </svg>
                  </div>
                  <h3 class="content-heading_component is-compact">Живые практикумы в&nbsp;Zoom по&nbsp;вторникам и&nbsp;пятницам: отработка в&nbsp;парах и&nbsp;тройках, ролл-плэи, разбор кейсов</h3>
                </li>

                <!-- 3. Обратная связь: облачко с галочкой, вокруг по орбите идёт точка -->
                <li class="sport-practice_card is-feedback">
                  <div class="sport-practice_visual" aria-hidden="true">
                    <svg class="sport-practice_svg sport-practice_smil" viewBox="0 0 300 180" fill="none">
                      <g transform="rotate(-12 150 92)">
                        <path id="practice-orbit" d="M30 92a120 36 0 1 0 240 0a120 36 0 1 0-240 0" stroke="currentColor" stroke-opacity=".2" stroke-width="1.5"/>
                        <circle r="5" fill="#a48df0"><animateMotion dur="7s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-orbit"/></animateMotion></circle>
                      </g>
                      <circle cx="150" cy="86" r="40" fill="#7c5cdb"/>
                      <path d="M134 74h32a5 5 0 0 1 5 5v15a5 5 0 0 1-5 5h-18l-10 8v-8h-4a5 5 0 0 1-5-5V79a5 5 0 0 1 5-5Z" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/>
                      <path d="m142 86 5 5 10-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path class="sport-practice_spark" d="M246 44c1 6 3 8 9 9-6 1-8 3-9 9-1-6-3-8-9-9 6-1 8-3 9-9Z" fill="#fff"/>
                      <path class="sport-practice_spark is-late" d="M58 128c.8 5 2.4 6.6 7.4 7.4-5 .8-6.6 2.4-7.4 7.4-.8-5-2.4-6.6-7.4-7.4 5-.8 6.6-2.4 7.4-7.4Z" fill="#fff"/>
                    </svg>
                  </div>
                  <h3 class="content-heading_component is-compact">Обратная связь преподавателя: что получилось и&nbsp;что стоит изменить</h3>
                </li>

                <!-- 4. Итоговый проект: окно документа, строки «пишутся» по очереди, в конце печать «защищено» -->
                <li class="sport-practice_card is-project">
                  <h3 class="content-heading_component is-compact">Итоговый индивидуальный проект: применяете всё изученное и&nbsp;защищаете на&nbsp;аттестации</h3>
                  <div class="sport-practice_visual is-bottom" aria-hidden="true">
                    <svg class="sport-practice_svg" viewBox="0 0 320 170" fill="none">
                      <rect x="16" y="14" width="320" height="190" rx="14" fill="#3b2e49" stroke="currentColor" stroke-opacity=".2"/>
                      <g fill="currentColor" fill-opacity=".3"><circle cx="38" cy="36" r="4.5"/><circle cx="54" cy="36" r="4.5"/><circle cx="70" cy="36" r="4.5"/></g>
                      <path d="M16 56h304" stroke="currentColor" stroke-opacity=".16"/>
                      <g class="sport-practice_lines">
                        <rect x="40" y="76" width="150" height="9" rx="4.5" fill="#a48df0"/>
                        <rect x="40" y="98" width="230" height="9" rx="4.5" fill="#fff" fill-opacity=".22"/>
                        <rect x="40" y="120" width="190" height="9" rx="4.5" fill="#fff" fill-opacity=".22"/>
                        <rect x="40" y="142" width="210" height="9" rx="4.5" fill="#fff" fill-opacity=".22"/>
                      </g>
                      <g class="sport-practice_stamp"><circle cx="276" cy="134" r="22" fill="#7c5cdb"/><path d="m266 134 7 7 13-14" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
                    </svg>
                  </div>
                </li>

                <!-- 5. Форматы занятий: плашки едут по дуге. Список для скринридера, сама лента скрыта от него -->
                <li class="sport-practice_card is-formats">
                  <h3 class="content-heading_component is-compact">Форматы занятий</h3>
                  <ul class="sport-practice_sr">
                    <li>Лекции в&nbsp;записи</li><li>Вебинары-практикумы</li><li>Ролл-плэи</li><li>Работа в&nbsp;тройках</li><li>Квизы</li><li>Разбор кейсов</li>
                  </ul>
                  <div class="sport-practice_visual is-belt" aria-hidden="true">
                    <svg class="sport-practice_svg sport-practice_smil" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" fill="none" data-practice-belt>
                      <path id="practice-belt" d="M-420 180C-150 180 40 96 200 96S550 180 820 180" stroke="currentColor" stroke-opacity=".14" stroke-width="1.5" stroke-dasharray="4 8"/>
                      <g data-practice-chip><animateMotion dur="36s" begin="0s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-86.5" y="-21.0" width="173" height="42" rx="12" fill="#7c5cdb"/><text y="6" text-anchor="middle" fill="#fff" font-size="17" font-weight="500">Лекции&#160;в&#160;записи</text></g>
                      <g data-practice-chip><animateMotion dur="36s" begin="-6s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-105.5" y="-21.0" width="211" height="42" rx="12" fill="#3b2e49" stroke="#fff" stroke-opacity=".2"/><text y="6" text-anchor="middle" fill="#fff" font-size="17" font-weight="500">Вебинары-практикумы</text></g>
                      <g data-practice-chip><animateMotion dur="36s" begin="-12s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-58.5" y="-21.0" width="117" height="42" rx="12" fill="#fff"/><text y="6" text-anchor="middle" fill="#2b2334" font-size="17" font-weight="500">Ролл-плэи</text></g>
                      <g data-practice-chip><animateMotion dur="36s" begin="-18s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-91.0" y="-21.0" width="182" height="42" rx="12" fill="#3b2e49" stroke="#fff" stroke-opacity=".2"/><text y="6" text-anchor="middle" fill="#fff" font-size="17" font-weight="500">Работа&#160;в&#160;тройках</text></g>
                      <g data-practice-chip><animateMotion dur="36s" begin="-24s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-39.5" y="-21.0" width="79" height="42" rx="12" fill="#7c5cdb"/><text y="6" text-anchor="middle" fill="#fff" font-size="17" font-weight="500">Квизы</text></g>
                      <g data-practice-chip><animateMotion dur="36s" begin="-30s" repeatCount="indefinite" rotate="auto"><mpath href="#practice-belt"/></animateMotion><rect x="-77.0" y="-21.0" width="154" height="42" rx="12" fill="#3b2e49" stroke="#fff" stroke-opacity=".2"/><text y="6" text-anchor="middle" fill="#fff" font-size="17" font-weight="500">Разбор&#160;кейсов</text></g>
                    </svg>
                  </div>
                </li>

                <!-- 6. Камеры и 80 %: кольцо заполняется до 80 %, когда карточка появляется на экране -->
                <li class="sport-practice_card is-attendance">
                  <h3 class="content-heading_component is-compact">Занятия живые, с&nbsp;включёнными камерами. Диплом получают те, кто посетил больше 80&nbsp;% занятий</h3>
                  <div class="sport-practice_visual" aria-hidden="true">
                    <svg class="sport-practice_svg is-ring" viewBox="0 0 180 180" fill="none">
                      <circle cx="90" cy="90" r="66" stroke="currentColor" stroke-opacity=".14" stroke-width="12"/>
                      <circle class="sport-practice_progress" cx="90" cy="90" r="66" stroke="#a48df0" stroke-width="12" stroke-linecap="round" pathLength="100" transform="rotate(-90 90 90)"/>
                      <path d="M76 70h20a5 5 0 0 1 5 5v14a5 5 0 0 1-5 5H76a5 5 0 0 1-5-5V75a5 5 0 0 1 5-5Zm25 10 10-6v16l-10-6" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/>
                      <text x="90" y="124" text-anchor="middle" fill="#fff" font-size="24" font-weight="500" letter-spacing="-.5">80&#8201;%</text>
                    </svg>
                  </div>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </section>
