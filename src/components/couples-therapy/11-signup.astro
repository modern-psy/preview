---
// couples-therapy: блок 11. Перенесён со старой страницы (scripts/legacy-to-astro.mjs). Цена и формы — общие компоненты, настройки в src/data/pages/couples-therapy.json.
import LeadForm from '../LeadForm.astro';
import page from '../../data/pages/couples-therapy.json';
---
      <!-- ============ 11. Форма заявки ============
           Общий компонент Академии (web-academy/shared/academy/request-form.md), режим «курс».
           Заголовок формы page.js берёт из CMS: «Занятия начнутся …», а в листе ожидания — «Запишитесь в лист ожидания».
           Заявка уходит через нативную форму Тильды «couples-therapy», которая уже стоит на живой странице (rec1080810061). -->
      <section class="couples-signup_component section-spacing_component" id="signup">
        <div class="padding-global">
          <div class="container-xlarge">
      <LeadForm id={page.forms.signup.id} form={page.forms.signup.form} options={page.forms.signup.options} lead={page.forms.signup.lead} cmsHeading={page.forms.signup.cmsHeading} />
          </div>
        </div>
      </section>
