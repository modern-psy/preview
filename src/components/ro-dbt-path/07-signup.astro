---
// ro-dbt-path: блок 7. Перенесён со старой страницы (scripts/legacy-to-astro.mjs). Цена и формы — общие компоненты, настройки в src/data/pages/ro-dbt-path.json.
import LeadForm from '../LeadForm.astro';
import page from '../../data/pages/ro-dbt-path.json';
---
      <!-- ========== 7. Форма заявки ==========
           Общий компонент Академии (web-academy/shared/academy/request-form.md), режим «курс».
           Заголовок и подзаголовок — со старой страницы. Заявка уходит через нативную форму Тильды, которая уже стоит
           на живой странице (её имя — в request-form-sync.mjs). -->
      <section class="path-signup_component section-spacing_component" id="signup">
        <div class="padding-global">
          <div class="container-xlarge">
      <LeadForm id={page.forms.signup.id} form={page.forms.signup.form} options={page.forms.signup.options} lead={page.forms.signup.lead} cmsHeading={page.forms.signup.cmsHeading} />
          </div>
        </div>
      </section>
