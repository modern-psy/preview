---
// rodbt-lvl2: блок 13. Перенесён со старой страницы (scripts/legacy-to-astro.mjs). Цена и формы — общие компоненты, настройки в src/data/pages/rodbt-lvl2.json.
import LeadForm from '../LeadForm.astro';
import page from '../../data/pages/rodbt-lvl2.json';
---
      <!-- price-block:end -->

      <!-- ========== 8. Форма заявки ==========
           Общий компонент Академии (web-academy/shared/academy/request-form.md), режим «курс».
           Заявка уходит через нативную форму Тильды rodbt-lvl2 (блок t1040 rec2220076591, варианты Telegram и Max).
           Заголовок со старой страницы, подзаголовок — короче трёх абзацев старой страницы (текст в sync-blocks.mjs). -->
      <section class="lvl2-signup_component section-spacing_component" id="signup">
        <div class="padding-global">
          <div class="container-xlarge">
      <LeadForm id={page.forms.signup.id} form={page.forms.signup.form} options={page.forms.signup.options} lead={page.forms.signup.lead} cmsHeading={page.forms.signup.cmsHeading} />
          </div>
        </div>
      </section>
