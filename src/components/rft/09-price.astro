---
// rft: блок 9. Блок цены из CMS (генератор /pricing) — общий компонент PriceBlock.
// Настройки — в src/data/pages/rft.json, раздел price: «Что входит» и вид блока.
import PriceBlock from '../PriceBlock.astro';
import page from '../../data/pages/rft.json';
---
<!-- ========== 9. Стоимость обучения ==========
     Как на /ifs и /couples-therapy: раскладка wa-narrow (колонка 64rem), фон #f5f5f5, шрифт v1 (src/styles/rft/page.css, раздел 9).
     Блок «Гибкие условия оплаты» со старой страницы (Zero) не переносится: те же условия уже внизу блока цены. -->
<div class="rftv-page" data-academy="1">
  <PriceBlock course={page.price.course} {...page.price.options} />
</div>
