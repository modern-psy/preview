<!-- T123 --> <div class="t123"> <div class="t-container_100 "> <div class="t-width t-width_100 "> <!-- nominify begin --> <!-- ============================================================
     БЛОК «АВТОР И ПРЕПОДАВАТЕЛЬ КУРСА»
     Страница: modern-psy.ru/ifs

     Один блок T123: шрифт, стили и разметка. Скрипта нет.
     Вставлять целиком вместо двух Zero-блоков: заголовка
     «Авторы и преподаватели курса» (rec1081446081) и карточки
     Юлии Варлаковой (rec1082874291). Старые блоки скрыть.
     Пустые Zero-блоки сверху и снизу (отступы) оставить как есть:
     у этого блока своих отступов сверху и снизу нет.

     Заголовок блока — как остальные заголовки страницы /ifs
     (жирный, 28 → 44px, тёмно-синий #1d1d33), но шрифтом Wix Madefor Text.

     Остальные стили — из библиотеки web-academy, один в один:
     · подзаголовок — section-subtitle,
       как в блоке «Вас будут обучать специалисты-практики»;
     · фото, имя и текст — карточка преподавателя teacher-card;
     · регалии — серые плашки meta-pill (тег из первого экрана Академии);
     · отступы — общая шкала web-academy (spacing.md),
       поля карточки 16px, как во всём проекте.
     Карточка в web-academy рассчитана на слайдер из нескольких
     преподавателей. Здесь преподаватель один, поэтому карточка белая
     и широкая: на большом экране фото слева, текст справа.

     Ширина блока повторяет соседние Zero-блоки страницы:
     от 1280px — 1280px по центру, от 800px — поля по 2% экрана,
     на телефоне — поля около 4,4% экрана (16px на ширине 360).

     Что можно менять: тексты, плашки, факты, фото (ссылка в src),
     подпись к фото (alt).
     Что нельзя: классы — по ним работают стили.
     ============================================================ --> <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:wght@400;444;500;700&display=swap"> <style is:inline>
/* Все правила начинаются с .ifs-teacher_component, чтобы не задеть
   остальные блоки Тильды. Внутри — имена классов из web-academy,
   чтобы блок легко было сверить с библиотекой. */
.ifs-teacher_component {
  /* Цвета web-academy (тема лендинга «Психолог-консультант») */
  --color-page-background: #eff2f9;   /* фон страницы /ifs; им же залиты плашки */
  --color-surface-primary: #ffffff;   /* белая карточка */
  --color-text-primary: #332f41;
  --color-text-secondary-large: #747476; /* серый текст на белом, контраст 4,7:1 */
  /* Подзаголовок секции стоит не на белом, а на фоне страницы: там серый
     #747476 даёт только 4,2:1, поэтому взят более тёмный серый
     из той же палитры web-academy, контраст 6:1. */
  --color-text-secondary-on-page: #5e5a6a;
  --color-border-subtle: #e8e7ee;     /* тонкая линия над фактами */
  --teacher-card-background: #e8e6ee; /* подложка под фото, пока оно грузится */
  --font-family-body: "Wix Madefor Text", Arial, sans-serif;

  /* Заголовок блока — как заголовки соседних Zero-блоков страницы:
     28px на телефоне, 44px на десктопном макете шириной 1280px.
     Между ними растёт плавно: 44 / 1280 = 3,4375% ширины экрана. */
  --page-heading-color: #1d1d33;
  --section-title-size: clamp(1.75rem, 3.4375vw, 2.75rem);

  /* Размеры и отступы web-academy. Ниже — значения для телефона (до 520px),
     для экранов шире они переопределяются в конце файла. */
  --section-subtitle-size: 1rem;         /* подзаголовок 16 · 18 · 20 · 22 */
  --profile-name-size: 1.375rem;         /* имя 22 · 24 · 28 · 32 */
  --profile-text-size: 0.9375rem;        /* текст карточки 15 · 16 · 18 · 20 */
  --space-heading-copy: 1.25rem;         /* заголовок → подзаголовок 20 · 20 · 24 · 28 */
  --space-section-content: 2rem;         /* шапка → карточка 32 · 36 · 42 · 70 */
  --teacher-card-media-gap: 0.75rem;     /* фото → текст 12 · 12 · 16 · 20 */
  --teacher-card-copy-gap: 0.5rem;       /* имя → должность 8 · 8 · 12 · 12 */
  --teacher-card-ratio: 24 / 25;         /* рамка фото 24:25 · 163:170 · 24:25 · 9:10 */
  --radius-card: 0.75rem;                /* радиус карточки 12 · 12 · 16 · 16 */
  --card-padding: 1rem;                  /* поля карточки 16 на всех экранах */
  --media-radius: 0.5rem;                /* радиус фото внутри карточки */
  --facts-gap: 0.5rem;                   /* между фактами 8 · 8 · 12 · 12 */
  --facts-icon-size: 1rem;               /* галочка у факта 16 · 18 */

  /* Плашка meta-pill is-responsive: текст 14 → 16, поля 5 → 6 по вертикали
     и 9 → 12 по бокам, плавно на ширине 375–991px (формулы из web-academy).
     Иконок в плашках нет, поэтому поле слева равно полю справа. */
  --meta-pill-size: calc(0.875rem + clamp(0rem, 0.51150895vw - 0.19181586rem, 0.125rem));
  --meta-pill-padding-y: calc(0.3125rem + clamp(0rem, 0.25575448vw - 0.09590793rem, 0.0625rem));
  --meta-pill-padding-x: calc(0.5625rem + clamp(0rem, 0.76726343vw - 0.28772379rem, 0.1875rem));

  display: block;
  margin: 0;
  padding: 0;
  background-color: var(--color-page-background); /* без полосы между блоками */
  color: var(--color-text-primary);
  font-family: var(--font-family-body);
  font-feature-settings: "lnum" 1, "pnum" 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.ifs-teacher_component *,
.ifs-teacher_component *::before,
.ifs-teacher_component *::after {
  box-sizing: border-box;
}

.ifs-teacher_component ::selection {
  background-color: #dad6ff; /* светло-сиреневый web-academy */
  color: var(--color-text-primary);
}

/* ---------- Ширина: как у соседних Zero-блоков ---------- */
/* Телефон: сетка 360px, растянутая на экран, поля по 16 из 360. */
.ifs-teacher_component .ifs-teacher_container {
  display: flex;
  flex-direction: column;
  gap: var(--space-section-content);
  width: 91.111%;
  margin: 0 auto;
}

/* ---------- Шапка секции (section-header web-academy) ---------- */
.ifs-teacher_component .section-header_component {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-heading-copy);
  width: 100%;
  max-width: 55rem; /* как у шапки секции преподавателей */
  min-width: 0;
  text-align: left;
}

/* Жирный, как Gilroy Bold в заголовках страницы. Межстрочный 1,2 —
   как у них (33px при 28, 52px при 44). Лёгкое сжатие −0,02em, как у
   заголовка соседнего блока «Модули можно приобрести по отдельности». */
.ifs-teacher_component .section-title_component {
  width: 100%;
  margin: 0;
  padding: 0;
  color: var(--page-heading-color);
  font-family: var(--font-family-body);
  font-size: var(--section-title-size);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
  text-wrap: balance;
  overflow-wrap: anywhere;
}

.ifs-teacher_component .section-subtitle_component {
  width: 100%;
  margin: 0;
  padding: 0;
  color: var(--color-text-secondary-on-page);
  font-family: var(--font-family-body);
  font-size: var(--section-subtitle-size);
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: -0.01em;
  text-wrap: pretty;
}

/* ---------- Белая карточка преподавателя ---------- */
/* Телефон: всё в столбик — фото, имя с должностью, плашки, факты. */
.ifs-teacher_component .ifs-teacher_profile {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    "media"
    "intro"
    "chips"
    "facts";
  row-gap: var(--teacher-card-media-gap);
  margin: 0;
  padding: var(--card-padding);
  border-radius: var(--radius-card);
  background-color: var(--color-surface-primary);
}

/* Фото (teacher-card_media) */
.ifs-teacher_component .teacher-card_media {
  grid-area: media;
  position: relative;
  width: 100%;
  aspect-ratio: var(--teacher-card-ratio);
  overflow: hidden;
  border-radius: var(--media-radius);
  background-color: var(--teacher-card-background);
}

.ifs-teacher_component .teacher-card_image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  margin: 0;
  object-fit: cover;
  object-position: center;
  -webkit-user-drag: none;
  user-select: none;
}

/* Имя и должность */
.ifs-teacher_component .ifs-teacher_intro {
  grid-area: intro;
  display: flex;
  flex-direction: column;
  gap: var(--teacher-card-copy-gap);
  min-width: 0;
}

/* Имя (content-heading is-profile) */
.ifs-teacher_component .content-heading_component {
  margin: 0;
  padding: 0;
  color: var(--color-text-primary);
  font-family: var(--font-family-body);
  font-size: var(--profile-name-size);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

/* Текст карточки (body-text is-reading) */
.ifs-teacher_component .body-text_component {
  margin: 0;
  padding: 0;
  color: var(--color-text-secondary-large);
  font-family: var(--font-family-body);
  font-size: var(--profile-text-size);
  font-weight: 444;
  line-height: 1.4;
  letter-spacing: normal;
  text-wrap: pretty;
  overflow-wrap: anywhere;
}

/* Должность — тёмным, как вводная строка (body-text_lead) */
.ifs-teacher_component .body-text_component.is-lead {
  color: var(--color-text-primary);
}

/* Регалии плашками (meta-pill_component is-responsive).
   Серые, не фиолетовые: это справка, а не акцент. */
.ifs-teacher_component .ifs-teacher_chips {
  grid-area: chips;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 0.5rem;
  min-width: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ifs-teacher_component .meta-pill_component {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: var(--meta-pill-padding-y) var(--meta-pill-padding-x);
  border-radius: 999px;
  background-color: var(--color-page-background);
  color: var(--color-text-primary);
  font-family: var(--font-family-body);
  font-size: var(--meta-pill-size);
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: -0.01em;
  white-space: normal;
}

.ifs-teacher_component .meta-pill_component::before,
.ifs-teacher_component .meta-pill_component::marker,
.ifs-teacher_component .ifs-teacher_fact::before,
.ifs-teacher_component .ifs-teacher_fact::marker {
  content: none;
}

/* Факты биографии под тонкой линией: столбик с галочками,
   как список в блоке диплома web-academy. Галочки тёмные, не фиолетовые. */
.ifs-teacher_component .ifs-teacher_facts {
  grid-area: facts;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--facts-gap);
  margin: calc(var(--space-heading-copy) - var(--teacher-card-media-gap)) 0 0;
  padding: var(--space-heading-copy) 0 0;
  border-top: 1px solid var(--color-border-subtle);
  list-style: none;
}

.ifs-teacher_component .ifs-teacher_fact {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  min-width: 0;
  margin: 0;
  padding: 0;
}

.ifs-teacher_component .ifs-teacher_icon {
  display: block;
  flex: none;
  width: var(--facts-icon-size);
  height: var(--facts-icon-size);
  /* опускаем галочку на середину первой строки текста */
  margin-top: calc((var(--profile-text-size) * 1.4 - var(--facts-icon-size)) / 2);
  color: var(--color-text-primary);
}

/* ---------- 521–767px ---------- */
@media (min-width: 32.5625rem) {
  .ifs-teacher_component {
    --section-subtitle-size: 1.125rem;
    --profile-name-size: 1.5rem;
    --profile-text-size: 1rem;
    --space-section-content: 2.25rem;
    --teacher-card-ratio: 163 / 170;
    --facts-icon-size: 1.125rem;
  }

  /* Фото и имя рядом; плашки и факты ниже на всю ширину карточки.
     Ширина фото — половина, как у карточки в слайдере преподавателей. */
  .ifs-teacher_component .ifs-teacher_profile {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "media intro"
      "chips chips"
      "facts facts";
    column-gap: var(--space-heading-copy);
  }

  /* имя и должность прижаты к нижнему краю фото */
  .ifs-teacher_component .ifs-teacher_intro {
    align-self: end;
  }
}

/* ---------- 768–1024px ---------- */
@media (min-width: 48rem) {
  .ifs-teacher_component {
    --section-subtitle-size: 1.25rem;
    --profile-name-size: 1.75rem;
    --profile-text-size: 1.125rem;
    --space-heading-copy: 1.5rem;
    --space-section-content: 2.625rem;
    --teacher-card-media-gap: 1rem;
    --teacher-card-copy-gap: 0.75rem;
    --teacher-card-ratio: 24 / 25;
    --radius-card: 1rem;
    --facts-gap: 0.75rem;
  }

  /* Справа от фото — имя, должность и плашки, прижаты к низу фото;
     факты ниже на всю ширину в две колонки. */
  .ifs-teacher_component .ifs-teacher_profile {
    grid-template-rows: minmax(0, 1fr) auto auto;
    grid-template-areas:
      "media intro"
      "media chips"
      "facts facts";
  }

  .ifs-teacher_component .ifs-teacher_facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-heading-copy);
  }
}

/* ---------- От 800px: поля как у среднего экрана Zero-блоков ---------- */
/* Сетка 800px, растянутая на экран: поле слева 16, ширина 769 из 800. */
@media (min-width: 800px) {
  .ifs-teacher_component .ifs-teacher_container {
    width: 96.125%;
    margin-left: 2%;
  }
}

/* ---------- От 1025px: фото слева, весь текст справа ---------- */
@media (min-width: 64.0625rem) {
  .ifs-teacher_component {
    --section-subtitle-size: 1.375rem;
    --profile-name-size: 2rem;
    --profile-text-size: 1.25rem;
    --space-heading-copy: 1.75rem;
    --space-section-content: 4.375rem;
    --teacher-card-media-gap: 1.25rem;
    --teacher-card-ratio: 9 / 10;
  }

  .ifs-teacher_component .ifs-teacher_profile {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas:
      "media intro"
      "media chips"
      "media facts";
    align-items: start;
  }

  /* Текст справа отодвинут от края карточки ещё на 8px:
     у крупной карточки поля 24px, как у больших плашек Академии. */
  .ifs-teacher_component .ifs-teacher_intro,
  .ifs-teacher_component .ifs-teacher_chips,
  .ifs-teacher_component .ifs-teacher_facts {
    padding-right: 0.5rem;
  }

  .ifs-teacher_component .ifs-teacher_intro {
    align-self: start;
    padding-top: 0.5rem;
  }

  /* на широком экране факты одной колонкой справа от фото */
  .ifs-teacher_component .ifs-teacher_facts {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* ---------- От 1280px: ширина 1280px по центру ---------- */
@media (min-width: 1280px) {
  .ifs-teacher_component .ifs-teacher_container {
    width: 80rem;
    margin-left: auto;
  }
}
</style> <section class="ifs-teacher_component" id="prepodavatel" aria-labelledby="ifs-teacher-heading"> <div class="ifs-teacher_container"> <div class="section-header_component"> <h2 class="section-title_component" id="ifs-teacher-heading">Автор и&nbsp;преподаватель курса</h2> <p class="section-subtitle_component">Наши преподаватели совмещают психологическую практику с&nbsp;научной работой, поэтому материал всегда будет актуален</p> </div> <article class="ifs-teacher_profile" aria-labelledby="ifs-teacher-name"> <!-- Фото преподавателя: квадрат 1200×1200 на S3, обрезается рамкой по краям --> <div class="teacher-card_media"> <img class="teacher-card_image" src="https://s3.twcstorage.ru/asp-media/varlakova_1200_252344399d.webp" alt="Юлия Варлакова, автор и преподаватель курса IFS" width="1200" height="1200" loading="lazy" decoding="async" draggable="false"> </div> <div class="ifs-teacher_intro"> <h3 class="content-heading_component" id="ifs-teacher-name">Юлия Варлакова</h3> <p class="body-text_component is-lead">Практикующий семейный психолог, сертифицированный IFS-терапевт</p> </div> <!-- Регалии плашками: коротко, по одной мысли в плашке.
           Новая плашка — скопировать строку <li> целиком. --> <ul class="ifs-teacher_chips" role="list" aria-label="Квалификация"> <li class="meta-pill_component">IFS Level&nbsp;3 trained</li> <li class="meta-pill_component">Сертификация IFS Institute</li> <li class="meta-pill_component">Магистр семейного консультирования и&nbsp;психотерапии</li> <li class="meta-pill_component">Преподаватель психологии</li> </ul> <!-- Факты биографии. Новый пункт — скопировать строку <li> целиком. --> <ul class="ifs-teacher_facts" role="list"> <li class="ifs-teacher_fact"><svg class="ifs-teacher_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="body-text_component">Основной фокус профессиональных интересов&nbsp;— привязанность и&nbsp;травма.</span></li> <li class="ifs-teacher_fact"><svg class="ifs-teacher_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="body-text_component">Автор книги для родителей, статей, публикаций, семинаров и&nbsp;тренингов для психологов и&nbsp;специалистов помогающих профессий.</span></li> <li class="ifs-teacher_fact"><svg class="ifs-teacher_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="body-text_component">Обучалась и&nbsp;работала в&nbsp;подходах: телесно-ориентированная травма-терапия, эмоционально-фокусированная терапия, ССТ, нарративная терапия.</span></li> <li class="ifs-teacher_fact"><svg class="ifs-teacher_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="body-text_component">Сейчас IFS&nbsp;— основной метод работы с&nbsp;клиентами, который интегрировал предыдущий профессиональный и&nbsp;личный опыт.</span></li> <li class="ifs-teacher_fact"><svg class="ifs-teacher_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="body-text_component">Ведёт IFS-семинары, воркшопы, группы практики и&nbsp;супервизии.</span></li> </ul> </article> </div> </section> <!-- nominify end --> </div> </div> </div>
</div>
