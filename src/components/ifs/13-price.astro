---
// ifs: блок 13. Блок цены из CMS (генератор /pricing) — общий компонент PriceBlock.
// Настройки — в src/data/pages/ifs.json, раздел price: тарифы, пакет супервизий, вид блока.
import PriceBlock from '../PriceBlock.astro';
import page from '../../data/pages/ifs.json';
---
<!-- ========== 13. Стоимость обучения ==========
     Вид как на /couples-therapy (правка Дарьи 27.11.2026: на живой странице блок был в другом фоне и шрифте):
     раскладка wa-narrow (колонка 64rem), фон страницы #f5f5f5, шрифт v1 (src/styles/ifs/page.css, раздел 13). -->
<div class="ifsv-page" data-academy="1">
  <PriceBlock course={page.price.course} {...page.price.options} />
</div>
